# =============================================================================
# HopeNest Environment Variables
# Copy this file to `.env.local` for local development and fill in values.
# Never commit `.env.local` or files containing real secrets to version control.
# =============================================================================

# Canonical Production Site URL (recommended on Vercel for custom domains;
# falls back automatically to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL on Vercel)
# NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# Public Application Settings (exposed to browser via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_APP_NAME="HopeNest"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="/api"

# Optional External Newsletter Endpoint override (defaults to built-in /api/newsletter)
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=""

# Authentication & Google OAuth 2.0 (server-only — REQUIRED AUTH_SECRET in Vercel production!)
# Generate AUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Optional explicit callback override (defaults to <origin>/api/auth/google/callback)
# GOOGLE_REDIRECT_URI=""

# Optional Email Delivery via Resend (https://resend.com) for Contact, Newsletter & Create Event
# RESEND_API_KEY=""
# CONTACT_FROM_EMAIL="HopeNest <onboarding@resend.dev>"
# CONTACT_TO_EMAIL="support@hopenest.com"
# NEWSLETTER_TO_EMAIL=""
# EVENT_SUBMISSIONS_TO_EMAIL=""

# Optional Webhook Forwarding & API Key
# API_SECRET_KEY=""
# CONTACT_WEBHOOK_URL=""
# NEWSLETTER_WEBHOOK_URL=""
# EVENT_SUBMISSIONS_WEBHOOK_URL=""
